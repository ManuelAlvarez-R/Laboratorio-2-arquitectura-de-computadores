##################
# Function: menu_decision
# Purpose: que el usuario pueda elegir si cifrar o descifrar un archivo con nombre valido
# Inputs: un numero para decidir que camino tomar
# $v0: variable que guardara temporalmente la decision del usuario
# Outputs: el camino elegido por el usuario
# $s3: un 0 o 1, depenediendo de lo que quiera el usuario, si es diferente se dara un mensaje de error
# Variables: 
# t1: guarda el comparador para tomar la decision
##################
menu_decision:
 li $v0, 4
 la $a0, mensaje_opciones
 syscall
 

 li $v0, 5  			#syscall que permite ingresar un numero
 syscall    			#se llama a syscall de $v0
 move $s3, $v0                  #guardamos en $s3 el valor elegido por el usuario
 j rellenar_datos

rellenar_datos:
 li $v0, 4
 la $a0, mensaje_palabra_clave
 syscall
 jal ingresar_palabra		#saltamos a la instruccion donde le pedimos al usuario la palabra clave
 jal conseguir_size_palabra_clave #saltamos a la instruccion donde conseguimos la longitud de la palabra              
 j decision			#saltamos a donde se hace la decision
  

decision:
 li $t1, 1			#se guarda un uno para decidir a donde se ira
 beq $s3, $t1, decision_cifrar  #se compara con 1 para ver si el usuario eligio cifrar
 beqz $s3,decision_descifrar	#se compara con 0 para ver si el usuario eligio descifrar
 li $v0, 4			#se prepara para imprimir en consola
 la $a0, mensaje_error_decision #se carga el mensaje
 syscall			#se imprime en consola
 j menu_decision		#se vuelve al inicio
 
 decision_cifrar:
 jal cifrar_mensaje 		#se usa jal para direccionar $ra a j menu_decision
 j menu_decision                #se vuelve al inicio
 
 decision_descifrar:
 jal descifrar_mensaje          #se usa jal para direccionar $ra a j menu_decision
 j menu_decision                #se vuelve al inicio
 

##################
# Function: ingresar_palabra
# Purpose: que el usuario ingrese la palabra en clave a traves de la consola
# Inputs: Palabra clave a traves de la consola
# $v0 permite leer un string
# $a1 maximo numero de letras que la palabra pueda tener (en bytes) donde cada letra es un byte
# Outputs: 
# $s0: direccion inicial de la palabra clave
# Variables: 

##################
ingresar_palabra:
 li $v0, 8  			#syscall que permite ingresar una palabra por consola
 la $a0, palabra_clave          #se carga la direccion inicial de la palabra clave
 li $a1, 2049 			#se carga el espacio maximo en bytes que la palabra clave puede tener
 syscall    			#se llama a syscal de $v0
 move $s0, $a0                  #guardamos en $s0 la direccion de la palabra clave
 jr $ra



##################
# Function: conseguir_size_palabra_clave:
# Purpose: encontrar la longitud de la palabra clave
# Inputs: Palabra
# Outputs: Numero de letras de la palabra clave
# $s1: numero de letras en la palabra clave(ejm 1, 8, 12)
# Variables: 
# $t0 apuntador al inicio de la palabra clave
# $t1 numero que guarda el tama?o de la palabra 
# $t2: variable que mira el valor almacenado en la posicion que apunta $t0
##################
conseguir_size_palabra_clave:
 la $t0, palabra_clave  #se carga la direccion inicial de la palabra clave 
 li $t1, 0              #se carga el indice que nos dara la longitud de la palabra
	
	
ciclo1:                                 #se agrega un ciclo que recorra la palabra
 lb $t2, ($t0)	                        #se carga el valor almacenado en la direccion inicial de la palabra  	
 beq $t2, $zero, salir_ciclo            #miramos que el valor sea diferente de cero. si es igual salatamos a la instruccion para salir del ciclo
 addi $t1, $t1, 1                       #a?adimos 1 al indice
 addi $t0, $t0, 1                       #pasamos a la siguiente letra (o palabra almacenada en la memoria)
 j ciclo1                               #volvemos al inicio del ciclo
	
salir_ciclo:
 move $s1, $t1                         #guardamos en $s1 el "size" de la palabra
 subi $s1, $s1, 1                      #hacemos el ajuste de "size" de palabra ya que tambien se guarda un salto de linea
 beqz $s1, longitud_cero               #verificamos que la palabra no sea cero
 jr $ra

longitud_cero:                         #En caso de que la longitud sea cero se le da un mensaje de error al usuario y vuelve a pedir la palabra clave
 li $v0, 4
 la $a0, mensaje_error_palabra_clave
 syscall
 j rellenar_datos
 
##################
# Function: cifrar_mensaje
# Purpose: Cargar el mensaje desde 'input.txt', aplicar el algoritmo de cifrado Vigenere usando la clave almacenada en $s0 e imprimir el resultado en 'criptogram.txt'
# Inputs: 
# $s0: direccion inicial de la palabra clave (obtenida en ingresar_palabra)
# $s1: cantidad de letras de la palabra clave (obtenida en conseguir_size_palabra_clave)
# Outputs: Archivo criptogram.txt generado con el texto plano
# Variables: 
# $t0: indice para recorrer el texto
# $t1: indice para recorrer la palabra clave
# $t2: caracter leido del texto
# $t3: caracter leido de la palabra clave
# $t4: valor del desplazamiento
# $t5: direccion donde empieza el texto que se va a cifrar
# $t6: limite inferior del intervalo de minusculas
# $t7: limite superior del intervalo de minusculas
# $t8: tama?o del alfabeto       
# $s2: cantidad de bytes leidos del archivo

##################

cifrar_mensaje:

# Guardar la direccion de retorno ($ra) en la pila
 addi $sp, $sp, -4               #guardamos la direccion anterior a la final
 sw $ra, 0($sp)                  #almacenamos da direccion de retorno de $sp en $ra

#Leer el archivo input.txt
 la $a0, archivo_input_txt       #cargamos la direccion del archivo a cifrar
 la $a1, buffer_input_txt        #cargamos la direccion donde esta el texto que se cifrara
 li $a2, 2049   		 #guardamos el espacio donde se almacenara el cifrado
 jal leer_archivo		 #usamos la funcion de leer archivo
 move $s2, $v0                   # $s2 guarda los bytes leidos
 bltz $s2, error_lectura_cifrado # mandamos el error si no se logro leer el archivo
    
#inicializamos los indices    
 li $t0, 0                       # Indice del mensaje
 li $t1, 0                       # Indice de la clave 

ciclo_cifrado:
 bge $t0, $s2, guardar_resultado_cifrado      #verificamos que no se halla leido todo el archivo
 la $t5, buffer_input_txt                     #cargamos la direccion donde empieza el texto que se va a cifrar
 add $t5, $t5, $t0			      #pasamos a la posicion $t5+i del texto que se va a cifrar
 lb $t2, 0($t5)                               #Cargar caracter actual
 
# Verificar si es letra mayuscula ('A' - 'Z')
 li $t6, 65				      #guardamos donde inician las letras mayusculas	
 li $t7, 90                                   #guardamos donde finalizan las letras mayusculas
 
 #se verifica que este en el intervalo
 blt $t2, $t6, verificar_minuscula_cifrado    
 bgt $t2, $t7, verificar_minuscula_cifrado

  # --- ES MAYUSCULA ---
  # Indice de la clave = $t1 % $s1
 div $t1, $s1                    # dividimos la posicion actual sobre la longitud de la palabra clave
 mfhi $t3                        # Residuo de la division
 add $t3, $s0, $t3               # Apuntar al caracter leido de la palabra clave
 lb $t3, 0($t3)                  # cargamos el caracter leido de la palabra clave

# Calcular desplazamiento (A/a = 0, B/b = 1, etc.)
 subi $t4, $t3, 97                               #al valor de la palabra clave le restamos 97
 bgez $t4, aplicar_formula_mayuscula_cifrado     #si el resultado es positivo o cero aplicamos la formula en mayuscula
 subi $t4, $t3, 65                               #su el resultado es menor que cero restamos 65

aplicar_formula_mayuscula_cifrado:
    # Formula: Ci = (Pi - 65 + desplazamiento + 26) % 26 + 65
    # donde Pi es el caracter leido de el texto
    subi $t2, $t2, 65               #hacemos Pi-65
    add $t2, $t2, $t4 		    #le sumamos el desplazamiento a el valor de la posicion actual
    addi $t2, $t2, 26               #Le sumamos  26 para evitar valores negativos
    li $t8, 26			    #cargamos el tama?o del alfabeto             
    div $t2, $t8                    #dividimos el caracter nuevo y lo dividimos por la cantidad de letras en el alfabeto
    mfhi $t2                        #cargamos el residuo que seria la nueva letra
    addi $t2, $t2, 65               #le sumamos 65 para que coincida con el codigo ASCII

    la $t5, buffer_cifrado          #cargamos la posicion inicial donde se guarda el texto cifrado
    add $t5, $t5, $t0               #nos movemos a la posicion de la letra que modificamos
    sb $t2, 0($t5)                  #almacenamos la letra cifrada en buffer_cifrado

    addi $t1, $t1, 1                # Avanzar indice de la clave
    j siguiente_caracter_cifrado            # pasamos al siguiente caracter
    
verificar_minuscula_cifrado:
    # Verificar si es letra minuscula ('a' - 'z')
    li $t6, 97                             #guardamos donde empiezan las minusculas
    li $t7, 122				   #guadramos donde terminan las minusculas
    blt $t2, $t6, no_es_letra_cifrado		   #si es menor que esta y no es mayuscula decimos que no es letra
    bgt $t2, $t7, no_es_letra_cifrado              #si es mayor que esta y no es mayuscula decimos que no es letra

    # --- ES MINUSCULA ---
    div $t1, $s1                           #dividimos la posicion actual sobre la longitud de la palabra clave              
    mfhi $t3				   #almacenamos el residuo de la anterior division
    add $t3, $s0, $t3                      #calculamos donde esta la ubicacion de la letra que indica el residuo
    lb $t3, 0($t3)                         #cargamos la nueva letra

    subi $t4, $t3, 97                                   #verificamos que el caracter de la palabra clave sea minuscula restandole a
    bgez $t4, aplicar_formula_minuscula_cifrado         #si era minuscula aplicamos el cifrado con las caratecristicas de la letras minusculas
    subi $t4, $t3, 65                                   #si no era minuscula se considerara mayuscula y se le resta A


aplicar_formula_minuscula_cifrado:
# Formula: Ci = (Pi - 97 + desplazamiento + 26) % 26 + 97
# donde Pi es el caracter leido de el texto
 subi $t2, $t2, 97       #hacemos Pi-97
 add $t2, $t2, $t4       #le sumamos el desplazamiento a el valor de la posicion actual
 addi $t2, $t2, 26       #Le sumamos  26 para evitar valores negativos
 li $t8, 26              #cargamos el tama?o del alfabeto             
 div $t2, $t8            #dividimos el caracter nuevo y lo dividimos por la cantidad de letras en el alfabeto
 mfhi $t2                #cargamos el residuo que seria la nueva letra
 addi $t2, $t2, 97       #le sumamos 97 para que coincida con el codigo ASCII
 
 la $t5, buffer_cifrado  #cargamos la posicion inicial donde se guarda el texto cifrado
 add $t5, $t5, $t0       #nos movemos a la posicion de la letra que modificamos
 sb $t2, 0($t5)          #almacenamos la letra cifrada en buffer_cifrado
 addi $t1, $t1, 1        # Avanzar indice de la clave
 j siguiente_caracter_cifrado  #pasamos al siguiente caracter


no_es_letra_cifrado:
    # Espacios, saltos de linea y caracteres especiales se copian igual
    la $t5, buffer_cifrado
    add $t5, $t5, $t0
    sb $t2, 0($t5)

siguiente_caracter_cifrado:
    addi $t0, $t0, 1                # Avanzar al siguiente byte del texto
    j ciclo_cifrado

guardar_resultado_cifrado:
# Poner terminador nulo '\0' al final
 la $t5, buffer_cifrado                  #cargamos la ultima posicion de la posicion donde queda el intervalo de cifrado            
 add $t5, $t5, $t0                           #le agregamos un cero
 sb $zero, 0($t5)                            #almacenamos la poscion final

# Escribir el resultado en criptogram.txt
 la $a0, archivo_cifrado                    #cargamos la posicion de donde empieza el archivo a crear (criptogram.txt en este caso)
 la $a1, buffer_cifrado			    #cargamos la longitud archivo maxima a crear (criptogram.txt en este caso)	
 move $a2, $s2                              #cargamos la longitud del archivo que vamos a leer
 jal escribir_archivo

# Notificar exito
 li $v0, 4				   #cargamos la instruccion que deseamos hacer
 la $a0, mensaje_exito_cifrado		   #cargamos el mensaje que vamos a enviar
 syscall			           #llamamos al sistema
 j fin_cifrado
 

    
error_lectura_cifrado:
    li $v0, 4
    la $a0, mensaje_error_archivo_a_cifrar
    syscall


fin_cifrado:
    lw $ra, 0($sp)
    addi $sp, $sp, 4
    jr $ra
    
##################
# Function: descifrar_mensaje
# Purpose: Cargar el criptograma desde 'criptogram.txt', aplicar el algoritmo de descifrado Vigenere usando la clave almacenada en $s0 e imprimir el resultado en 'deciphered.txt'
# Inputs: 
# $s0: direccion inicial de la palabra clave (obtenida en ingresar_palabra)
# $s1: cantidad de letras de la palabra clave (obtenida en conseguir_size_palabra_clave)
# Outputs: Archivo deciphered.txt generado con el texto plano
# Variables: 
# $t0: indice para recorrer el texto
# $t1: indice para recorrer la palabra clave
# $t2: caracter leido del criptograma
# $t3: caracter leido de la palabra clave
# $t4: valor del desplazamiento
# $s2: cantidad de bytes leidos del archivo
##################
descifrar_mensaje:
    # Guardar la direccion de retorno ($ra) en la pila
    addi $sp, $sp, -4
    sw $ra, 0($sp)

    # 1. Leer el archivo criptogram.txt
    la $a0, archivo_criptograma
    la $a1, buffer_criptograma
    li $a2, 2049
    jal leer_archivo
    move $s2, $v0                   # $s2 guarda los bytes leidos
    bltz $s2, error_lectura

    # 2. Inicializar indices
    li $t0, 0                       # Indice del mensaje
    li $t1, 0                       # Indice de la clave

ciclo_descifrado:
    bge $t0, $s2, guardar_resultado_descifrado

    la $t5, buffer_criptograma
    add $t5, $t5, $t0
    lb $t2, 0($t5)                  # Cargar caracter actual

    # Verificar si es letra mayuscula ('A' - 'Z')
    li $t6, 65
    li $t7, 90
    blt $t2, $t6, verificar_minuscula
    bgt $t2, $t7, verificar_minuscula

    # --- ES MAYUSCULA ---
    # Indice de la clave = $t1 % $s1
    div $t1, $s1
    mfhi $t3                        # Residuo de la division
    add $t3, $s0, $t3               # Apuntar al caracter en palabra_clave
    lb $t3, 0($t3)

    # Calcular desplazamiento (A/a = 0, B/b = 1, etc.)
    subi $t4, $t3, 97
    bgez $t4, aplicar_formula_mayuscula
    subi $t4, $t3, 65

aplicar_formula_mayuscula:
    # Formula: Mi = (Pi - 65 - desplazamiento + 26) % 26 + 65
    subi $t2, $t2, 65
    sub $t2, $t2, $t4
    addi $t2, $t2, 26               # Evitar valores negativos
    li $t8, 26
    div $t2, $t8
    mfhi $t2                        # Operacion modulo 26
    addi $t2, $t2, 65               # Convertir de nuevo a ASCII

    la $t5, buffer_salida
    add $t5, $t5, $t0
    sb $t2, 0($t5)                  # Guardar en el buffer de salida

    addi $t1, $t1, 1                # Avanzar indice de la clave
    j siguiente_caracter




verificar_minuscula:
    # Verificar si es letra minuscula ('a' - 'z')
    li $t6, 97
    li $t7, 122
    blt $t2, $t6, no_es_letra
    bgt $t2, $t7, no_es_letra

    # --- ES MINUSCULA ---
    div $t1, $s1
    mfhi $t3
    add $t3, $s0, $t3
    lb $t3, 0($t3)

    subi $t4, $t3, 97
    bgez $t4, aplicar_formula_minuscula
    subi $t4, $t3, 65

aplicar_formula_minuscula:
    # Formula: Mi = (Pi - 97 - desplazamiento + 26) % 26 + 97
    subi $t2, $t2, 97
    sub $t2, $t2, $t4
    addi $t2, $t2, 26
    li $t8, 26
    div $t2, $t8
    mfhi $t2
    addi $t2, $t2, 97

    la $t5, buffer_salida
    add $t5, $t5, $t0
    sb $t2, 0($t5)

    addi $t1, $t1, 1                # Avanzar indice de la clave
    j siguiente_caracter

no_es_letra:
    # Espacios, saltos de linea y caracteres especiales se copian igual
    la $t5, buffer_salida
    add $t5, $t5, $t0
    sb $t2, 0($t5)

siguiente_caracter:
    addi $t0, $t0, 1                # Avanzar al siguiente byte del texto
    j ciclo_descifrado

guardar_resultado_descifrado:
    # Poner terminador nulo '\0' al final
    la $t5, buffer_salida
    add $t5, $t5, $t0
    sb $zero, 0($t5)

    # Escribir el resultado en deciphered.txt
    la $a0, archivo_descifrado
    la $a1, buffer_salida
    move $a2, $s2
    jal escribir_archivo

    # Notificar exito
    li $v0, 4
    la $a0, mensaje_exito_descifrado
    syscall
    j fin_descifrado

error_lectura:
    li $v0, 4
    la $a0, mensaje_error_archivo_criptogram
    syscall

fin_descifrado:
    lw $ra, 0($sp)
    addi $sp, $sp, 4
    jr $ra


##################
# Function: leer_archivo
# Purpose: Abrir 'criptogram.txt' en modo lectura y cargarlo en la RAM
# Inputs: 
# $a0: nombre del archivo
# $a1: direccion del buffer receptor
# $a2: cantidad maxima de bytes a leer
# Outputs: 
# $v0: cantidad de bytes leidos (-1 si ocurre un error)
##################
leer_archivo:
    move $t0, $a1
    move $t1, $a2

    li $v0, 13                      # Syscall 13: Abrir archivo
    li $a1, 0                       # Modo 0 = Solo lectura
    li $a2, 0
    syscall

    bltz $v0, error_abrir_archivo
    move $t2, $v0                   # Descriptor de archivo

    li $v0, 14                      # Syscall 14: Leer archivo
    move $a0, $t2
    move $a1, $t0
    move $a2, $t1
    syscall
    move $t3, $v0                   # Bytes leidos

    li $v0, 16                      # Syscall 16: Cerrar archivo
    move $a0, $t2
    syscall

    move $v0, $t3
    jr $ra

error_abrir_archivo:
    li $v0, -1
    jr $ra


##################
# Function: escribir_archivo
# Purpose: Crear el archivo 'deciphered.txt' y escribir el mensaje descifrado
# Inputs:
# $a0: nombre del archivo de salida
# $a1: direccion del buffer de datos
# $a2: cantidad de bytes a escribir
##################
escribir_archivo:
    move $t0, $a1
    move $t1, $a2

    li $v0, 13                      # Syscall 13: Abrir archivo
    li $a1, 1                       # Modo 1 = Escritura
    li $a2, 0
    syscall

    move $t2, $v0                   # Descriptor de archivo

    li $v0, 15                      # Syscall 15: Escribir archivo
    move $a0, $t2
    move $a1, $t0
    move $a2, $t1
    syscall

    li $v0, 16                      # Syscall 16: Cerrar archivo
    move $a0, $t2
    syscall

    jr $ra
