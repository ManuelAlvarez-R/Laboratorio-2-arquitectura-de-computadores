.data
#mensajes de texto

mensaje_opciones: .asciiz "\n Seleccione lo que desea hacer, 1 para cifrar un texto, 0 para descifrar un archivo encriptado\n"
mensaje_palabra_clave: .asciiz "\n Escriba la palabra clave para el cifrado o descifrado \n"
mensaje_error_decision: .asciiz "\n Error se puso un valor no valido\n"
mensaje_exito_descifrado: .asciiz "\n[EXITO] Mensaje descifrado correctamente en deciphered.txt\n"
mensaje_error_archivo_criptogram:   .asciiz "\n[ERROR] No se pudo abrir el archivo criptogram.txt\n"
mensaje_error_palabra_clave: .asciiz "\n[ERROR] La palabra clave no puede estar vacia.txt\n"
mensaje_exito_cifrado: .asciiz "\n[EXITO] Mensaje cifrado correctamente en criptogram.txt\n"
mensaje_error_archivo_a_cifrar:   .asciiz "\n[ERROR] No se pudo abrir el archivo input.txt\n"

#palabra que el usuario ingresara
palabra_clave: .space 2049

#archivos que se leeran
archivo_input_txt: .asciiz "input.txt"
archivo_criptograma: .asciiz "criptogram.txt"

#espacios para el texto
buffer_input_txt:    .space 2049
buffer_criptograma:  .space 2049



#archivos que se devuelven
archivo_cifrado: .asciiz "criptogram.txt"
archivo_descifrado:  .asciiz "deciphered.txt"

#espacio de archivos
buffer_cifrado:      .space 2049
buffer_salida:       .space 2049


.text  



######################################################
# Procedure coding
